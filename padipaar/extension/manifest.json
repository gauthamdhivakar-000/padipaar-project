{
  "manifest_version": 3,
  "name": "PadiPaar - Read What You Sign",
  "short_name": "PadiPaar",
  "version": "1.0.0",
  "description": "Finds risky clauses and dark patterns on terms and sign-up pages and explains them in simple Tamil.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "PadiPaar - scan this page",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
