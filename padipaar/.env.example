# Copy to .env (never commit it). All values are optional.
# Allow only your own site/extension to call the API (default "*")
ALLOWED_ORIGINS=*
# Set a secret to enable POST /api/admin/scores (used by scripts/seed_scores.py). Leave empty to disable.
ADMIN_KEY=
# Requests per minute per visitor for the analyse endpoints
RATE_LIMIT_PER_MIN=40
# Where the SQLite score board is stored
# DB_PATH=/var/data/padipaar.db
